# Razorpay credentials — https://dashboard.razorpay.com/app/keys
# The key ID is public (used by the checkout widget in the browser).
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# The secret must NEVER be exposed to the client. Server-side only.
RAZORPAY_KEY_SECRET=your_key_secret_here

# Canonical site URL used for metadata, sitemap, and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://cares-platform-blue.vercel.app
